<style>
{% include_raw "plugins/_shared/styles.css" %}

/* The device is a 1-bit panel: anything lighter than roughly mid-grey thresholds
   to white and disappears. --rule-soft (#e5e5e5) vanished entirely on hardware,
   taking every row separator with it, and text at opacity 0.55 went with it. So
   this plugin uses its own hairline and never leans on opacity for legibility.
   #8a8a8a was still too light — it sits above the midpoint and thresholds white.
   Separators use --ink-soft (#555), which lands on the black side. */
.screen { overflow: hidden; }

/* ── Hero: the single most imminent deadline, inverted for contrast ───────── */
.hero { display: flex; align-items: center; justify-content: space-between;
  background: var(--ink); color: var(--bg); padding: 9px 22px 10px; gap: 20px; flex-shrink: 0; }
.hero-lbl { font-size: 9px; letter-spacing: 0.26em; text-transform: uppercase;
  opacity: 0.72; font-weight: 800; margin-bottom: 3px; }
.hero-title { font-size: 20px; font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; }
.hero-course { font-size: 11px; letter-spacing: 0.06em; opacity: 0.75; margin-top: 3px; }
.hero-r { text-align: right; flex-shrink: 0; }
.hero-cd { font-family: var(--mono); font-size: 26px; font-weight: 800; line-height: 1; letter-spacing: -0.02em; }
.hero-when { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
  opacity: 0.75; margin-top: 5px; }

/* ── Body: agenda on the left, deadline queue on the right ────────────────── */
.body { flex: 1; display: grid; grid-template-columns: 1fr 268px; min-height: 0; overflow: hidden; }
.agenda { padding: 9px 16px 0 22px; min-height: 0; overflow: hidden; }
.rail { border-left: 2px solid var(--ink); padding: 9px 20px 0 18px;
  display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.col-h { font-size: 9px; font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase;
  color: var(--ink-soft); padding-bottom: 5px; border-bottom: 2px solid var(--ink); }

/* ── Agenda rows ───────────────────────────────────────────────────────────
   Every row is the same three columns — day gutter, marker, content — so the
   times, the titles and "nothing scheduled" all share one left edge. Empty days
   render a spacer in the marker column rather than skipping it, which is what
   used to knock their text out of alignment with everything else. */
.drow { display: grid; grid-template-columns: 54px 1fr; gap: 12px;
  padding: 6px 0 7px; border-bottom: 1px solid var(--ink-soft); align-items: start; }
.drow:last-child { border-bottom: none; }
.dlabel { font-size: 11px; font-weight: 800; letter-spacing: 0.08em;
  color: var(--ink-soft); padding-top: 3px; white-space: nowrap; }

/* Today reads as an inverted tab, not a rule underneath the label. The old
   20x2px block floated free of the text and looked like a stray dash. */
.drow.today .dlabel { color: var(--bg); background: var(--ink);
  padding: 3px 6px 3px 22px; margin-left: -22px; }
.drow.today .ititle { font-weight: 800; }

/* Mono, at the same size as .itime: it lands exactly on the time column, and the
   chunkier face survives 1-bit thresholding where letter-spaced sans did not. */
.clear { font-family: var(--mono); font-size: 10.5px; color: var(--ink-soft);
  letter-spacing: 0.01em; padding-top: 3px; }

/* ── One scheduled thing ──────────────────────────────────────────────────── */
.item { display: grid; grid-template-columns: 15px 1fr; column-gap: 9px; margin-bottom: 6px; }
.item:last-child { margin-bottom: 0; }
.mark { width: 9px; height: 9px; margin-top: 4px; border: 2px solid var(--ink); }
.mark-spacer { display: block; }
.item.class .mark { border-radius: 50%; }
.item.due .mark { background: var(--ink); transform: rotate(45deg); width: 8px; height: 8px; }
.item-body { display: block; }
.itime { display: block; font-family: var(--mono); font-size: 10.5px; font-weight: 700;
  letter-spacing: 0.01em; color: var(--ink-soft); line-height: 1.3; }
.ititle { display: block; font-size: 13.5px; font-weight: 700; line-height: 1.22; margin-top: 1px; }
/* A class is a fixed block of her day; a deadline is a task. Same size, so the
   agenda reads as one list, distinguished by the marker and the chip. */
.item.class .ititle { font-weight: 800; }
.item.past .itime, .item.past .ititle { color: var(--ink-soft); }
.item.past .ititle { text-decoration: line-through; text-decoration-thickness: 1px; }
.item.past .mark { background: var(--bg); border-color: var(--ink-soft); }
.item.past .chip { border-color: var(--ink-soft); }
.chip { display: inline-block; font-size: 9px; font-weight: 800; letter-spacing: 0.1em;
  text-transform: uppercase; border: 1.5px solid var(--ink); border-radius: 2px;
  padding: 1px 5px; margin-left: 7px; vertical-align: 2px; white-space: nowrap; }

/* ── Right rail ───────────────────────────────────────────────────────────── */
.q { padding: 6px 0 5px; border-bottom: 1px solid var(--ink-soft); }
.q-when { font-family: var(--mono); font-size: 10px; font-weight: 700; color: var(--ink-soft); }
.q.is-today .q-when { color: var(--ink); }
.q-title { font-size: 11.5px; font-weight: 700; line-height: 1.18; margin-top: 2px; }
.q-course { font-size: 9px; font-weight: 800; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--ink-soft); margin-top: 3px; }
.placeholder .shape { display: inline-block; font-family: var(--mono); font-size: 10px;
  text-align: left; max-width: 680px; word-break: break-all; opacity: 0.75; }
.drow.more .dlabel { font-family: var(--mono); color: var(--ink-soft); letter-spacing: 0; }
</style>

{%- comment -%}
  All date maths, Eastern-time formatting, course attribution and countdown
  wording happen in transform.js. This template only arranges strings: TRMNL's
  Liquid has no `now` variable and its `date` filter cannot shift time zones, so
  any calculation here would be wrong on the device.

  `ok` is false when the polling response wasn't a calendar — a bad or expired
  share link, most likely — which is a different failure from an empty week.
{%- endcomment -%}

{%- if ok == false -%}
  <div class="screen">
    <div class="title-bar">
      <div class="t-stack">
        <span class="t">This Week</span>
        <span class="t-sub">Blackboard</span>
      </div>
    </div>
    <div class="placeholder setup">
      <div>
        Couldn't read the Blackboard calendar feed.<br/><br/>
        <small>Check the share link in plugin settings — Blackboard → Calendar → Share Calendar.</small>
        {%- if debug_shape %}<br/><br/><small class="shape">Received: {{ debug_shape }}</small>{% endif -%}
      </div>
    </div>
  </div>
{%- else -%}
  <div class="screen">
    <div class="title-bar">
      <div class="t-stack">
        <span class="t">This Week</span>
        <span class="t-sub">Blackboard · This week</span>
      </div>
      <div class="meta">{{ today_label }}<br/><span style="opacity:0.6">Updated {{ updated_at }}</span></div>
    </div>

    {%- if next_up -%}
      <div class="hero">
        <div class="hero-l">
          <div class="hero-lbl">Next up</div>
          <div class="hero-title">{{ next_up.title }}</div>
          <div class="hero-course">{{ next_up.course }}</div>
        </div>
        <div class="hero-r">
          <div class="hero-cd">{{ next_up.countdown }}</div>
          <div class="hero-when">{{ next_up.when_label }}</div>
        </div>
      </div>
    {%- endif -%}

    <div class="body">
      <div class="agenda">
        <div class="col-h">Next 7 days</div>
        {%- for row in day_rows -%}
          {%- if row.kind == "more" -%}
            <div class="drow more">
              <div class="dlabel">{{ row.label }}</div>
              <div class="item"><span class="mark-spacer"></span><span class="clear">{{ row.text }}</span></div>
            </div>
          {%- else -%}
            <div class="drow{% if row.is_today %} today{% endif %}">
              <div class="dlabel">{{ row.label }}</div>
              <div>
                {%- if row.items.size == 0 -%}
                  {%- comment -%}
                    The spacer keeps this text on the same left edge as every
                    item title, instead of starting where the markers are.
                  {%- endcomment -%}
                  <div class="item"><span class="mark-spacer"></span><span class="clear">nothing scheduled</span></div>
                {%- endif -%}
                {%- for it in row.items -%}
                  <div class="item {{ it.kind }}{% if it.past %} past{% endif %}">
                    <span class="mark"></span>
                    <span class="item-body">
                      <span class="itime">{{ it.time_label }}</span>
                      <span class="ititle">{{ it.title }}{% if it.course != blank %}<span class="chip">{{ it.course }}</span>{% endif %}</span>
                    </span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="rail">
        <div class="col-h">Due next</div>
        {%- for q in queue -%}
          <div class="q{% if q.is_today %} is-today{% endif %}">
            <div class="q-when">{{ q.when_label }}</div>
            <div class="q-title">{{ q.title }}</div>
            <div class="q-course">{{ q.course }}</div>
          </div>
        {%- else -%}
          <div class="q"><div class="q-title">Nothing due.</div></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}
